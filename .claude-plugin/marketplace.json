  "metadata": {
    "description": "A curated collection of high-quality plugins for Claude Code",
    "version": "1.0.0",
    "pluginRoot": "./plugins"
  },
  "plugins": [
    {
      "name": "coding",
      "source": "./plugins/coding",
      "description": "代码质量工具集：代码研究、技术方案、注释、审查、简化、模式指南，内置专项审查和构建修复 Agents",
      "version": "2.2.0",
      "author": {
        "name": "fawetian"
      },
      "keywords": ["code", "review", "research", "technical-design", "architecture", "annotation", "simplify", "quality"]
